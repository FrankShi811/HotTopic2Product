# Default local development mode. It creates clearly labelled demo concepts and
# never calls a third-party model.
MODEL_MODE=demo
DATA_DIR=./data

# Enable only on the trusted server process. Never expose this value to Vite or
# browser code, and do not commit a real .env file.
# MODEL_MODE=gemini
# GEMINI_API_KEY=replace-with-server-secret
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
